# Copy this file to .env before running `docker compose up -d`.
#
# Generate a hash instead of storing the password in the clear:
#   docker compose run --rm eye-of-lotus -hash-password 'your password'
# and paste the result here. A plain value works too, but the panel logs a
# warning about it at startup.

EOL_PASSWORD=change-me

# Optional
EOL_VERSION=dev
EOL_LOG_LEVEL=info
EOL_TRUST_PROXY=false
EOL_SYSTEMD=false
EOL_DOCKER=false
