[Unit]
Description=Eye of Lotus server monitor
Documentation=https://github.com/nelvixboy/eye-of-lotus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eye-of-lotus
Group=eye-of-lotus

ExecStart=/usr/local/bin/eye-of-lotus -config /etc/eye-of-lotus/config.json

# The panel writes exactly one file: its history database. Everything
# else it touches is read-only.
ReadWritePaths=/var/lib/eye-of-lotus
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=false
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# ProtectProc is deliberately left at its default: the panel walks
# /proc/<pid>/fd to name the process behind each listening socket, and
# hiding other processes' /proc entries would remove that.
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
# Reading every process's /proc/<pid>/fd is how the panel names the
# process behind a listening socket. Without this it still works, it just
# shows the port without an owner.
ProcSubset=all

# Restart on failure, but not in a tight loop.
Restart=on-failure
RestartSec=5s

# Logging goes to the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
